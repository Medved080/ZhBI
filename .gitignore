.venv/
__pycache__/
*.pyc
.DS_Store
# Боевая БД и ЛЮБЫЕ её копии. Шаблон именно `data/zhbi.db*`, а не
# `data/*.db`: аварийная пересборка и ручные снимки оставляют файлы вида
# `zhbi.db.rebuilt-20260729_192649` — на `.db` они не заканчиваются, под
# прежнее правило не подпадали и лежали в рабочей копии готовыми к
# случайному `git add -A`. Внутри — все учётные записи с хэшами паролей.
data/*.db
data/zhbi.db*
data/backups/
# Карта соответствий обезличивания (scripts/anonymize_db.py): «исходное
# значение → псевдоним», то есть ВСЕ настоящие названия контрагентов, ФИО,
# номера договоров, имена объектов и чертежей одним файлом. Сам скрипт
# пишет, что она в git не уходит, но правила на это не было: `data/*.db`
# её не ловит, и один `git add -A` отправил бы наружу ровно то, ради
# сокрытия чего скрипт и написан. В data/ кода нет вовсе — закрываем всё.
data/*.json
# Очередь переноса базы (app/db_transfer.py): загруженный, но ещё не
# применённый снимок — это ВСЯ база другого сервера одним файлом, вместе
# с пользователями и паролями. Под `*.zip` ниже он и так подпадает, но
# правило здесь явное: там оно про «архивы вообще», а тут про боевые
# данные, и снимать его нельзя ни при какой чистке .gitignore.
data/transfer/
uploads/
# Исходные DXF, которые сервер подхватывает при старте (см. Docs/TZ.md,
# 3.1) — пользовательские данные конкретного развёртывания, не код.
Input/
# Черновой вывод CLI-скриптов при ручных запусках (scripts/*.py) — не
# используется работающим сервером, не нужен в истории кода.
output/
# Машинно-специфичная конфигурация конкретного развёртывания (порт,
# security-флаги) — см. .env.example, который остаётся в git как шаблон.
.env
# Личный allowlist разрешённых команд для Claude Code на этой машине
# (накапливается по ходу сессий) — не общий код, .claude/launch.json
# (конфиг запуска dev-сервера для Browser pane) остаётся в git.
.claude/settings.local.json
# Рабочие копии Claude Code (git worktree) — временные, в истории не нужны.
.claude/worktrees/

# ---------------------------------------------------------------- данные
# Ниже — данные заказчика и рабочие материалы, а не код. Решение держать
# их вне git принято (Docs/DEPLOYMENT_LINUX.md §3.7), но до аудита
# безопасности 2026-08-03 держалось ТОЛЬКО на дисциплине: все эти пути
# висели в `git status` как неотслеживаемые, то есть один `git add -A`
# отправлял бы 2 ГБ чертежей и моделей в GitHub. Закрепляем правилом.
Модели/
test_data/
*.zip

# Логи локально запущенных серверов (uvicorn на 8000/8010/8020).
logs/
