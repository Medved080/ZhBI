.venv/
__pycache__/
*.pyc
.DS_Store
data/*.db
data/backups/
uploads/
# Исходные DXF, которые сервер подхватывает при старте (см. Docs/TZ.md,
# 3.1) — пользовательские данные конкретного развёртывания, не код.
Input/
# Черновой вывод CLI-скриптов при ручных запусках (scripts/*.py) — не
# используется работающим сервером, не нужен в истории кода.
output/
# Машинно-специфичная конфигурация конкретного развёртывания (порт,
# security-флаги) — см. .env.example, который остаётся в git как шаблон.
.env
# Личный allowlist разрешённых команд для Claude Code на этой машине
# (накапливается по ходу сессий) — не общий код, .claude/launch.json
# (конфиг запуска dev-сервера для Browser pane) остаётся в git.
.claude/settings.local.json
