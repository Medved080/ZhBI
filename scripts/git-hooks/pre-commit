#!/bin/sh
# Страж неопределённых имён перед коммитом (2026-08-18).
#
# Проверяет ПРОИНДЕКСИРОВАННОЕ содержимое питоновских файлов: обращение к
# имени, которого нет, в коммит не проходит. Такой дефект уже стоил четырёх
# дней — форма контрагента не открывалась, а падало на строке, куда заходили
# только оттуда (Docs/backlog.md 2026-08-18).
#
# Сам хук в git не версионируется — ставится из scripts/git-hooks командой
#   .venv/bin/python scripts/install_git_hooks.py
# Разовый обход, когда действительно надо: git commit --no-verify
#
# Имена переменных ЛАТИНИЦЕЙ: /bin/sh (POSIX) кириллический идентификатор за
# имя переменной не считает и принимает строку за команду — на этом хук уже
# падал с «КОРЕНЬ=...: No such file or directory».

set -e

ROOT=$(git rev-parse --show-toplevel)

# Виртуальное окружение проекта, если оно есть: в нём тот же Python, на
# котором работает сервис. Иначе — системный python3; скрипту хватает
# стандартной библиотеки, так что сработает и он.
if [ -x "$ROOT/.venv/bin/python" ]; then
    PYTHON="$ROOT/.venv/bin/python"
else
    PYTHON=python3
fi

exec "$PYTHON" "$ROOT/scripts/check_undefined_names.py" --staged
