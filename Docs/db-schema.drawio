        <mxCell id="lgb5" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="5834" y="334" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="lgt5" value="Справочники, настройки, журнал" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5870" y="334" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="lgn" value="&lt;b&gt;PK&lt;/b&gt; — первичный ключ, &lt;b&gt;FK&lt;/b&gt; — внешний ключ, &lt;b&gt;U&lt;/b&gt; — уникальность.&lt;br&gt;&lt;br&gt;&lt;b&gt;Сплошная&lt;/b&gt; линия — внешний ключ, подпись = поведение ON DELETE.&lt;br&gt;«Гусиная лапка» — сторона «многие», одинарная черта — сторона «один».&lt;br&gt;&lt;b&gt;Пунктир&lt;/b&gt; — логическая связь по значению, без FK в схеме.&lt;br&gt;&lt;br&gt;&lt;b&gt;Цвет линии&lt;/b&gt; — таблица, НА КОТОРУЮ она ссылается: все ссылки на &lt;font color=&quot;#1a73c8&quot;&gt;objects&lt;/font&gt; синие, на &lt;font color=&quot;#2f9e44&quot;&gt;users&lt;/font&gt; зелёные, на &lt;font color=&quot;#b54708&quot;&gt;contracts&lt;/font&gt; коричневые, на &lt;font color=&quot;#7048e8&quot;&gt;zones&lt;/font&gt; фиолетовые.&lt;br&gt;Дуга-«мостик» на пересечении означает, что линии не связаны.&lt;br&gt;&lt;br&gt;У каждой связи своя вертикальная дорожка в промежутке между колонками. Связи через две и более колонки уходят вниз, на «шину» под схемой, и поднимаются к предку — чтобы не проходить поверх таблиц." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="5834" y="378" width="400" height="290" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
