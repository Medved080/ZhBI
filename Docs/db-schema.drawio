        <mxCell id="t_object_levels_sort_order_9_c" value="&lt;b&gt;sort_order&lt;/b&gt; &lt;font color=&quot;#808080&quot;&gt;INTEGER&lt;/font&gt; — порядок показа: у обычного этажа — его номер, у заведённых вручную безномерных — 9000 и выше" style="shape=partialRectangle;connectable=0;fillColor=none;align=left;verticalAlign=middle;strokeColor=none;overflow=hidden;spacingLeft=8;spacingRight=8;html=1;fontSize=11;" vertex="1" parent="t_object_levels_sort_order_9"><mxGeometry width="520" height="24" as="geometry"/></mxCell>
