        <mxCell id="lgt2" value="Элементы ЖБИ и история статусов" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="9770" y="232" width="360" height="20" as="geometry"/></mxCell>
