        <mxCell id="lgb0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="9734" y="164" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="lgt0" value="Иерархия: проекты и объекты" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="9770" y="164" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="lgb1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="9734" y="198" width="26" height="20" as="geometry"/></mxCell>
        <mxCell id="lgt1" value="Пользователи, сессии, доступ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="9770" y="198" width="360" height="20" as="geometry"/></mxCell>
