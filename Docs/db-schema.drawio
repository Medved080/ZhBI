        <mxCell id="t_object_levels_elevation_source_7" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#6c8ebf;" vertex="1" parent="t_object_levels"><mxGeometry y="202" width="520" height="24" as="geometry"/></mxCell>
