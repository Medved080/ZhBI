# Скопировать в .env (не в git — машинно-специфичная конфигурация
# конкретного развёртывания) и поправить под конкретный сервер:
#   cp .env.example .env

# Порт на хосте, на который будет пробрасываться контейнер (внутри
# контейнера сервер всегда слушает 8000).
PORT=8000

# Включать ТОЛЬКО вместе с реальным HTTPS (например, за reverse-proxy с
# TLS-сертификатом) — иначе браузер перестанет отправлять cookie сессии
# и вход сломается. Пока публикация только внутри корпоративной сети без
# TLS — оставить закомментированным/0.
# ZHBI_SECURE_COOKIES=1

# Включать ТОЛЬКО за реальным доверенным reverse-proxy, который сам
# подставляет X-Forwarded-For — иначе rate-limit на /login можно обойти
# подделкой заголовка.
# ZHBI_TRUST_PROXY_HEADERS=1

# /docs, /redoc, /openapi.json — включать только для локальной отладки.
# ZHBI_ENABLE_DOCS=1

# Максимальный размер загружаемого DXF в мегабайтах (по умолчанию 200).
# ZHBI_MAX_UPLOAD_MB=200

# Список пользователей на экране входа (выпадающий список вместо ручного
# ввода логина). ВКЛЮЧЁН по умолчанию — сервис работает внутри
# корпоративного контура. Раскрывает список валидных логинов и ФИО
# НЕаутентифицированному клиенту, то есть снимает с атакующего половину
# работы. ОБЯЗАТЕЛЬНО выставить 0, если сервис станет доступен извне —
# форма входа сама вернётся к обычному текстовому полю.
# ZHBI_PUBLIC_LOGIN_LIST=0
